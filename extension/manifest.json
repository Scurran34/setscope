{
  "manifest_version": 3,
  "name": "Rabbithole capture",
  "version": "0.6.2",
  "description": "Sends the set links from a 1001Tracklists page you opened from Rabbithole to the Rabbithole app you opened it from (on this computer, or a shared link), then closes that tab.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7331/*",
    "http://localhost:7331/*",
    "https://*.trycloudflare.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.1001tracklists.com/*",
        "https://1001tracklists.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:7331/*",
        "http://localhost:7331/*",
        "https://*.trycloudflare.com/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
